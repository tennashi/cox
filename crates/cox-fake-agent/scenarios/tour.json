{
  "configOptions": [
    {
      "id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "default",
      "options": [
        { "value": "default", "name": "Ask", "description": "Ask before each edit" },
        { "value": "acceptEdits", "name": "Accept edits", "description": "Edit without asking" },
        { "value": "plan", "name": "Plan", "description": "Read and plan, change nothing" }
      ]
    },
    {
      "id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": "large",
      "options": [
        { "value": "large", "name": "Large", "description": "The most able, and the slowest" },
        { "value": "medium", "name": "Medium", "description": "For most work" },
        { "value": "small", "name": "Small", "description": "The quickest, for small tasks" }
      ]
    },
    {
      "id": "effort", "name": "Effort", "category": "thought_level", "type": "select", "currentValue": "medium",
      "options": [
        { "value": "low", "name": "Low" },
        { "value": "medium", "name": "Medium" },
        { "value": "high", "name": "High" }
      ]
    }
  ],
  "commands": [
    { "name": "compact", "description": "Sum up the conversation so far, to go on with less" },
    { "name": "review", "description": "Review the changes on this branch", "input": { "hint": "what to look at" } },
    { "name": "init", "description": "Write a COX.md for the project" }
  ],
  "turns": [
    {
      "when": "/compact",
      "steps": [{ "say": "Summed up the conversation so far." }]
    },
    {
      "steps": [
        { "think": "Look at what the program prints before changing anything." },
        { "tool": { "id": "read-1", "title": "Read src/main.rs", "kind": "read", "locations": [{ "path": "{cwd}/src/main.rs" }], "status": "completed" } },
        { "sleep": 500 },
        { "say": "The program prints a bare `hello` from `src/main.rs:2`. To name the user, it needs to know who they are." }
      ]
    },
    {
      "steps": [
        { "tool": { "id": "edit-1", "title": "Edit src/main.rs", "kind": "edit", "locations": [{ "path": "{cwd}/src/main.rs" }], "status": "pending" } },
        {
          "ask": {
            "toolCall": {
              "toolCallId": "edit-1",
              "title": "Edit src/main.rs",
              "content": [
                {
                  "type": "diff",
                  "path": "src/main.rs",
                  "oldText": "fn main() {\n    println!(\"hello\");\n}\n",
                  "newText": "fn main() {\n    println!(\"hello, {}\", whoami::username());\n}\n"
                }
              ]
            },
            "options": [
              { "optionId": "allow", "name": "Yes", "kind": "allow_once" },
              { "optionId": "reject", "name": "No", "kind": "reject_once" }
            ],
            "then": {
              "allow": [
                { "tool_update": { "id": "edit-1", "status": "completed" } },
                { "say": "The greeting in `src/main.rs` names the user now." }
              ],
              "reject": [
                { "tool_update": { "id": "edit-1", "status": "failed" } },
                { "say": "Left as it was. The change would go in `src/main.rs:2`." }
              ]
            }
          }
        }
      ]
    },
    {
      "steps": [
        { "call": { "tool": "show_file", "arguments": { "path": "src/main.rs", "first_line": 1, "last_line": 3 } } },
        { "say": "It is on the stage: {result}" }
      ]
    }
  ]
}
